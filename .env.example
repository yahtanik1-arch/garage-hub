# Скопируйте этот файл в .env и заполните. Сам .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Главный администратор: заменить своим Telegram ID. 0 — права никому не выданы.
ADMIN_ID=0
# Только исходящие HTTPS-запросы к Telegram (включая фото и уведомления).
# TELEGRAM_PROXY_URL=socks5://username:password@host:port
# Можно HTTP CONNECT: http://username:password@host:port. Не MTProto.
# Пустое значение — прямое соединение. При отказе прокси прямого обхода нет.
TELEGRAM_PROXY_URL=
# Supabase → Settings → API: адрес проекта и секретный (service_role) ключ
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Необязательно
# EXTRA_ADMIN_IDS=     дополнительные админы через запятую
# ADMIN_TG=            контакт админа для пользователей, например @username
# ADMIN_PHONE=         телефон админа для пользователей
# WEBAPP_URL=          публичный HTTPS-адрес Mini App (на сервере с доменом); без него — временный туннель
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# MINIAPP_DEV=         1 — вход без Telegram для разработки, только на своём компьютере. На сервере не включать

# Telegram webhook на сервере с постоянным HTTPS-адресом.
# Пустые значения сохраняют long polling для локального запуска.
# Перед запуском применить sql/000–003 по README.
# TELEGRAM_WEBHOOK_URL=https://example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=  случайный секрет: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'

# Production: отключены имитатор и вход без Telegram.
APP_ENV=production
LOCK_PROVIDER=disabled
# Право ручного открытия отдельно от обычного администратора; по умолчанию никому.
MANUAL_UNLOCK_ADMIN_IDS=
# Своя PostgreSQL: PostgREST слушает только loopback; ключ JWT — в SUPABASE_SECRET_KEY.
# Например POSTGREST_URL=http://127.0.0.1:3000. Для Supabase оставить пустым.
POSTGREST_URL=
