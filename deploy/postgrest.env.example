# Образец /etc/garagehub/postgrest.env; права root:garagehub 0640.
# Заменить пароль и JWT-секрет. Не коммитить заполненный файл.
# SUPABASE_SECRET_KEY приложения — подписанный этим секретом JWT с role=service_role.
PGRST_DB_URI=postgresql://garagehub_authenticator:REPLACE_DB_PASSWORD@127.0.0.1:5432/garagehub
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=anon
PGRST_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PGRST_SERVER_HOST=127.0.0.1
PGRST_SERVER_PORT=3000
PGRST_DB_POOL=10
